# Port d'écoute local de la passerelle (doit correspondre à WHATSAPP_BRIDGE_HOST
# dans le .env de DojoManager, ex: 127.0.0.1:9300).
PORT=9300

# 0 : la passerelle n'écoute que sur ce poste (127.0.0.1) — seul ce navigateur peut
#     l'appeler.
# 1 : elle écoute aussi sur le réseau local (0.0.0.0) — utile si DojoManager est
#     utilisé depuis un téléphone/autre PC du même Wi-Fi (configurer alors l'adresse
#     IP de ce poste dans le bouton ⚙ de la page reçu, ex: 192.168.1.50:9300).
ALLOW_LAN=0

# Jeton partagé optionnel : si renseigné ici, doit être recopié dans
# WHATSAPP_BRIDGE_TOKEN du .env de DojoManager. Recommandé si ALLOW_LAN=1, pour
# empêcher qu'un autre appareil du même Wi-Fi n'envoie des messages via ce numéro.
BRIDGE_TOKEN=

# Origines autorisées à appeler cette passerelle (liste séparée par des virgules),
# c'est-à-dire l'URL exacte du site DojoManager. Sans ça, le navigateur bloque
# l'appel (CORS). Exemple local XAMPP :
ALLOWED_ORIGINS=http://localhost/DojoManager_laravel,http://127.0.0.1/DojoManager_laravel
